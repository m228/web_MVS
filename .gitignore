# --- окружение и IDE (локальное, у каждого своё) ---
/.venv
/.idea
/.vscode
/.claude
/rules
/agents

# --- кэш Python ---
__pycache__/
*.pyc
*.pyo

# --- артефакты сборки PyInstaller (собираются из исходников) ---
/build
/dist
/app

# --- пользовательские данные (создаются в работе приложения) ---
/dataset
/Videos
/cv_results
/cv_history
/rtsp_cameras.json
/save_settings.json
/plate_config.json
/plate_config.last_good.json
/plate_config.corrupt.json
/config_backups

# --- временная папка самообновления ---
/.update

# --- локальная временная папка (планы, разовые пробы, кэш) ---
/tmp
CLAUDE.md
tasks/todo.md
.idea/misc.xml
.idea/web_MVS.iml
bug.txt

# --- материалы разработки (нужны только на этой машине, пользователю не раскрываем) ---
/Docs
/tasks
/tools
/task.txt
